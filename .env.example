# Copie para .env e preencha. O .env NUNCA deve ir para o Git.

# development | production | testing
APP_ENV=development

# Gere uma chave com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria

# Vazio = SQLite em instance/filmes_series.db
# Exemplos: mysql+pymysql://usuario:senha@localhost:3306/filmes_series
#           postgresql://usuario:senha@localhost:5432/filmes_series
DATABASE_URL=

# TMDb: crie uma conta gratuita em https://www.themoviedb.org/settings/api
# e use o "Token de leitura da API" (recomendado) OU a "Chave da API".
TMDB_API_TOKEN=
TMDB_API_KEY=
TMDB_LANGUAGE=pt-BR

# Fontes externas: chave Fernet estável, compartilhada entre importador e servidor.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SOURCE_ENCRYPTION_KEY=
# Domínios exatos separados por vírgula, incluindo os destinos de redirects.
SOURCE_ALLOWED_HOSTS=

# Opcional para testes SQLite no Render (somente quando DATABASE_URL estiver ausente).
CATALOG_SEED_PATH=
